<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ealert"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"/>

        <TextView
            android:id="@+id/tvLI"
            android:layout_below="@id/logo"
            android:layout_width="match_parent"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:textStyle="italic"
            android:text="LOG IN"
            android:textSize="30sp"
            android:textColor="#FF5722"
            android:fontFamily="@font/alexandria_extrabold"/>

        <TextView
            android:id="@+id/tvEnterUN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:text="ENTER USERNAME/EMAIL"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/tvLI"/>

        <EditText
            android:id="@+id/etEnterUN"
            android:layout_below="@id/tvEnterUN"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:hint="username/email"/>

        <TextView
            android:id="@+id/tvEnterPW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="10dp"
            android:text="ENTER PASSWORD"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/etEnterUN"/>

        <EditText
            android:id="@+id/etEnterPW"
            android:layout_below="@id/tvEnterPW"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:inputType="textPassword"
            android:hint="password"/>

        <TextView
            android:id="@+id/tvForgotPW"
            android:layout_below="@id/etEnterPW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F48A82"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_extrabold"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="50dp"
            android:padding="10dp"
            android:text="FORGOT PASSWORD?"/>

        <FrameLayout
            android:id="@+id/setimgbtnLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="75dp"
            android:layout_below="@id/tvForgotPW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/imgbtnLogin"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:contentDescription="LOGIN"
                android:background="@drawable/button_orange"/>
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:text="LOGIN"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:fontFamily="@font/alexandria_extrabold"/>
        </FrameLayout>

        <TextView
            android:id="@+id/donthave"
            android:layout_below="@id/setimgbtnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_marginStart="50dp"
            android:padding="5dp"
            android:text="DON'T HAVE AN ACCOUNT?"/>

        <TextView
            android:id="@+id/tvbtnSignUp"
            android:layout_toEndOf="@id/donthave"
            android:layout_below="@id/setimgbtnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F48A82"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_extrabold"
            android:padding="5dp"
            android:text="SIGN UP"/>

    </RelativeLayout>
</ScrollView>