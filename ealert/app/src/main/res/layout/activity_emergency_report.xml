<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportEmergency"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="20dp"
        android:background="@drawable/back_icon"/>

    <ImageView
        android:id="@+id/ivFire"
        android:layout_below="@id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:background="@drawable/nav_fire"/>

    <TextView
        android:id="@+id/tvFire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FIRE"
        android:paddingHorizontal="5dp"
        android:textSize="25sp"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:fontFamily="@font/alexandria_medium"
        android:layout_toEndOf="@id/ivFire"
        android:layout_below="@id/btnBack"/>

    <ImageView
        android:id="@+id/ivPhone"
        android:layout_below="@id/tvFire"
        android:layout_toEndOf="@id/ivFire"
        android:layout_marginHorizontal="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/phone_call"/>

    <FrameLayout
        android:id="@+id/setimgbtnCall"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvFire"
        android:layout_toEndOf="@id/ivPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/buttonCall"
            android:layout_width="170dp"
            android:layout_height="70dp"
            android:contentDescription="Emergency Call"
            android:background="@drawable/button_tapped"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:text="EMERGENCY\nCALL"
            android:textAlignment="center"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:fontFamily="@font/alexandria_extrabold"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvConcern"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUBMIT A REPORT"
        android:padding="10dp"
        android:textSize="15sp"
        android:textColor="#BFFFFFFF"
        android:textStyle="italic"
        android:fontFamily="@font/alexandria_medium"
        android:layout_below="@id/ivPhone"/>

    <EditText
        android:id="@+id/editTextConcern"
        android:layout_below="@id/tvConcern"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_height="150dp"
        android:textSize="15sp"
        android:textColor="#BFFFFFFF"
        android:fontFamily="@font/alexandria_medium"
        android:textColorHint="#80FFFFFF"
        android:padding="10dp"
        android:hint="CONCERN:"
        android:background="@drawable/underline"/>

    <RelativeLayout
        android:id="@+id/mapContainer"
        android:layout_below="@id/editTextConcern"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_margin="10dp">

        <!-- Search Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <fragment
                android:id="@+id/autocomplete_fragment"
                android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.cardview.widget.CardView>

        <!-- Map Fragment -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/searchCard" />

    </RelativeLayout>

    <ImageButton
        android:id="@+id/buttonAttachPhoto"
        android:layout_alignBottom="@id/editTextConcern"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:background="@drawable/attach_a_photo"/>

    <TextView
        android:id="@+id/PhotoFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/editTextConcern"
        android:layout_toStartOf="@id/buttonAttachPhoto"
        android:textSize="15sp"
        android:textColor="#BFFFFFFF"
        android:textStyle="italic"
        android:layout_marginVertical="30dp"/>

    <FrameLayout
        android:id="@+id/setimgbtnSubmit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="-50dp"
        android:layout_below="@id/mapContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/buttonSubmitReport"
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Submit Report"
            android:background="@drawable/button_orange"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:text="Submit"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:fontFamily="@font/alexandria_extrabold"/>
    </FrameLayout>

</RelativeLayout>