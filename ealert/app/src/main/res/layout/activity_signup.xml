<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:id="@+id/signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="180dp"
            android:layout_height="150dp"
            android:background="@drawable/ealert"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvSU"
            android:layout_below="@id/logo"
            android:layout_width="120dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="SIGN UP"
            android:textSize="25sp"
            android:textColor="#FF5722"
            android:fontFamily="@font/alexandria_extrabold"/>

        <TextView
            android:id="@+id/tvCreateUN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:text="CREATE USERNAME"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/tvSU"/>

        <EditText
            android:id="@+id/etCreateUN"
            android:layout_below="@id/tvCreateUN"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:hint="create username"/>

        <TextView
            android:id="@+id/tvEnterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:text="ENTER EMAIL"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/etCreateUN"/>

        <EditText
            android:id="@+id/etEnterEmail"
            android:layout_below="@id/tvEnterEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:inputType="textEmailAddress"
            android:hint="email"/>

        <TextView
            android:id="@+id/tvCreatePW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:text="CREATE PASSWORD"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/etEnterEmail"/>

        <EditText
            android:id="@+id/etCreatePW"
            android:layout_below="@id/tvCreatePW"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:hint="create password"
            android:inputType="textPassword"/>

        <TextView
            android:id="@+id/tvConfirmPW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:text="CONFIRM PASSWORD"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_below="@id/etCreatePW"/>

        <EditText
            android:id="@+id/etConfirmPW"
            android:layout_below="@id/tvConfirmPW"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/edittext"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:inputType="textPassword"
            android:hint="confirm password"/>

        <FrameLayout
            android:id="@+id/setimgbtnSignUp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:layout_below="@id/etConfirmPW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/imgbtnSignUp"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:contentDescription="LOGIN"
                android:background="@drawable/button_orange"/>
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:text="SIGN UP"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:fontFamily="@font/alexandria_extrabold"/>
        </FrameLayout>

        <TextView
            android:id="@+id/donthave"
            android:layout_below="@id/setimgbtnSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_medium"
            android:layout_marginStart="50dp"
            android:padding="5dp"
            android:text="ALREADY HAVE AN ACCOUNT?"/>

        <TextView
            android:id="@+id/tvbtnLogIn"
            android:layout_toEndOf="@id/donthave"
            android:layout_below="@id/setimgbtnSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F48A82"
            android:textStyle="italic"
            android:fontFamily="@font/alexandria_extrabold"
            android:padding="5dp"
            android:text="LOG IN"/>

    </RelativeLayout>
</ScrollView>